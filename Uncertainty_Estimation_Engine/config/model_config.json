{
  "model_registry": {
    "bayesian_linear": {
      "class": "core.bayesian_estimator.BayesianEstimator",
      "params": { "prior": "normal", "n_samples": 5000, "burn_in": 1000 },
      "description": "Full Bayesian linear regression with MCMC posterior sampling"
    },
    "gp_rbf": {
      "class": "models.gaussian_process.GaussianProcessUncertainty",
      "params": { "kernel": "rbf", "length_scale": 1.0, "amplitude": 1.0, "noise_var": 0.001 },
      "description": "Gaussian Process with RBF kernel"
    },
    "gp_matern": {
      "class": "models.gaussian_process.GaussianProcessUncertainty",
      "params": { "kernel": "matern52", "length_scale": 0.5, "amplitude": 2.0, "noise_var": 0.001 },
      "description": "Gaussian Process with Matérn 5/2 kernel"
    },
    "mc_dropout": {
      "class": "models.dropout_uncertainty.DropoutUncertaintyModel",
      "params": { "n_forward_passes": 100, "task": "regression" },
      "description": "MC Dropout neural network uncertainty"
    },
    "deep_ensemble": {
      "class": "models.deep_ensemble.DeepEnsemble",
      "params": { "n_members": 5, "adversarial_training": false },
      "description": "Deep Ensemble with 5 members"
    },
    "evidential_regression": {
      "class": "models.evidential_network.EvidentialNetwork",
      "params": { "task": "regression" },
      "description": "Evidential deep learning for regression (NIG prior)"
    },
    "conformal_regression": {
      "class": "core.conformal_prediction.ConformalPredictor",
      "params": { "alpha": 0.1, "task": "regression" },
      "description": "Split conformal predictor (90% coverage guarantee)"
    }
  },
  "default_model": "bayesian_linear",
  "version": "1.0.0"
}
