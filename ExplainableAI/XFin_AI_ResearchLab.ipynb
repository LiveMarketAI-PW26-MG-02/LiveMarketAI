# ─── Collect DL predictions ───────────────────────────────────────────────────
def get_preds(model, dl):
    model.eval()
    preds, trues = [], []
    with torch.no_grad():
        for xb, yb in dl:
            preds.append(model(xb.to(DEVICE)).cpu().numpy())
            trues.append(yb.numpy())
    return np.concatenate(preds), np.concatenate(trues)

