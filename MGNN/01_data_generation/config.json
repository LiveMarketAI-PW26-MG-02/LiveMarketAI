{
  "module": "MGNN",
  "abbr": "mgnn",
  "subfolder": "01_data_generation",
  "version": "1.0.0",
  "random_seed": 42,
  "data": {
    "n_assets": 50,
    "n_trading_days": 252,
    "tick_per_day": 390,
    "manipulation_prob": 0.15,
    "n_sentiment_posts_per_asset": 200,
    "n_orderbook_levels": 10
  },
  "model": {
    "feature_dim": 32,
    "hidden_dim": 64,
    "n_layers": 3,
    "n_heads": 4,
    "n_regimes": 5,
    "dropout_rate": 0.1,
    "use_temporal": true
  },
  "training": {
    "n_epochs": 30,
    "learning_rate": 0.001,
    "weight_decay": 1e-4,
    "batch_size": 16,
    "patience": 5,
    "train_split": 0.8,
    "val_split": 0.1,
    "test_split": 0.1
  },
  "inference": {
    "threshold": 0.5,
    "streaming_window": 50,
    "n_assets_per_window": 15
  },
  "risk_scoring": {
    "weights": {
      "price": 0.30,
      "volume": 0.25,
      "sentiment": 0.25,
      "graph": 0.20
    },
    "thresholds": {
      "critical": 0.85,
      "high": 0.70,
      "medium": 0.55,
      "low": 0.40
    }
  },
  "neo4j": {
    "uri": "bolt://localhost:7687",
    "username": "neo4j",
    "password": "${NEO4J_PASSWORD}",
    "database": "neo4j"
  },
  "output_dir": "outputs/mgnn_output",
  "log_level": "INFO"
}